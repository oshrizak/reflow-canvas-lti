# Line-ending policy.
#
# GitHub Desktop on Windows will otherwise rewrite whole files as CRLF,
# producing phantom diffs (660 changed lines with zero content change).
# Normalise everything to LF in the repo; check out LF everywhere.

* text=auto eol=lf

*.py   text eol=lf
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.json text eol=lf

# PowerShell on EBW-WCA01 must stay CRLF — scripts there are read by
# PS 5.1, which mis-parses LF-only files with non-ASCII characters.
*.ps1  text eol=crlf

# Never touch these.
*.png binary
*.jpg binary
*.pdf binary
*.pem binary
*.ico binary
